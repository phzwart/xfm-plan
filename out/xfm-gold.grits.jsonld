    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "The artifacts can be removed by normalizing your data to the TIME channel."
    }
   }
  },
  {
   "@id": "q:smak-stack-align",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
