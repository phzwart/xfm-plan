    "media_type": "text/plain"
   },
   "target": {
    "hasSource": "https://www.sams-xrays.com/smak-basics",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "If there is curvature to this line, then the detector is being saturated and you should do a deadtime correction."
    }
   }
  },
  {
