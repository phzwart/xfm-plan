   "@id": "der:time-scalar",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "derived",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "summary": "The time-normalization scalar 0.0000125 is the reciprocal of an 80 MHz dwell clock.",
   "rationale": "SMAK divides by the TIME channel and multiplies by 80,000,000 (q:code-time-norm); the guide's scalar 0.0000125 is 1/80,000,000, i.e. the TIME channel counts an 80 MHz clock and the operation converts counts to counts per second."
  },
  {
   "@id": "der:dt-paralyzable",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "derived",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "summary": "SMAK's dead-time correction is the paralyzable (exponential) model.",
   "rationale": "corFF = FF*exp(tau*1e-6*ICR) (q:code-dt-model, q:code-dt-apply) is the paralyzable dead-time model with tau in microseconds and ICR in counts per second."
  },
  {
   "@id": "der:corrections-viewtime",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "derived",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "summary": "In SMAK, dead-time and I0 corrections are view-time toggles, default off, leaving no trace in saved channels.",
   "rationale": "dodt and doI0c are Tk IntVars (q:code-dt-toggle, q:code-i0-toggle) whose default is 0, applied when a channel is rendered or analysed (q:code-dt-apply, q:code-i0-divide) rather than written as new channels. Off unless the operator switches them on; no record in the data file."
  },
  {
   "@id": "der:smak-fit-linear",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "derived",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "summary": "SMAK per-pixel spectrum fitting is unweighted linear least squares with a fixed peak shape.",
   "rationale": "SMAK calls PyMca FastXRFLinearFit.fitMultipleSpectra with weight=None and refit=True (q:code-fastfit, q:code-fastfit-args) under a configuration in which zero, gain, noise, fano and sum are all fixed (q:code-cfg-fixed, q:code-cfg-fixedzero). Per-pixel fitting is therefore an unweighted linear fit of line areas with a fixed peak model; the non-linear parameters are never refit per pixel."
  },
  {
   "@id": "der:quant-linear-cal",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "derived",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "summary": "SMAK quantification is a linear calibration C = slope*(A/I0)+intercept, not a pure ratio.",
   "rationale": "Quantification divides by the chosen I0 channel (q:code-quant-divide), then applies C = slope*(A/I0) + intercept (q:code-quant-poly). This is a linear calibration curve, which reduces to a ratio only when intercept is zero. The normalization channel may be None (q:code-quant-nonorm)."
  },
  {
   "@id": "der:stack-translation-only",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "derived",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "summary": "SMAK automatic stack alignment is translation-only.",
   "rationale": "Automatic stack alignment estimates a translation by phase correlation on high-pass-filtered images (q:code-stack-transl, q:code-stack-hipass, q:code-stack-phase); no rotation or scale is estimated."
  },
  {
   "@id": "der:manual-tps",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "derived",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "summary": "SMAK manual registration is a thin-plate-spline warp on landmarks.",
   "rationale": "Manual registration warps the image with a thin-plate spline fitted to operator landmark pairs (q:code-tps); it is a non-rigid deformation, not an affine transform."
  },
  {
   "@id": "der:fa-weighting",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "derived",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "summary": "Weighted-group FA balancing: w_g = max n / n_g, iterated three times; sign fixed by largest loading.",
   "rationale": "Group norm n_g = mean over channels in group g of sum_k |loading_kc| (q:code-fa-norm, q:code-fa-grp); weight w_g = max_g' n_g' / n_g (q:code-fa-adj), applied and re-estimated for 3 cycles (q:code-fa-cycles). Component sign is flipped so the largest-magnitude loading is positive (q:code-fa-sign)."
  },
  {
   "@id": "der:ftir-steps-separate",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "derived",
