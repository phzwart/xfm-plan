   }
  },
  {
   "@id": "q:smak-time-artifact",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "https://www.sams-xrays.com/smak-basics",
    "sha256": "438d870a78b3381dc3475033dc26cf5fd6f8ec0370d9029bb7dc0c323d4d5db1",
