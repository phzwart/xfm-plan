    "uri": "https://www.sams-xrays.com/smak-basics",
    "sha256": "438d870a78b3381dc3475033dc26cf5fd6f8ec0370d9029bb7dc0c323d4d5db1",
    "media_type": "text/plain"
   },
   "target": {
    "hasSource": "https://www.sams-xrays.com/smak-basics",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "We VERY rarely do deadtime corrections on data collected at the micro-imaging beamlines at SSRL because our detectors are linear to very high count rates (ICR > 3 million counts per second)."
    }
   }
  },
  {
   "@id": "q:smak-dt-rule",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
