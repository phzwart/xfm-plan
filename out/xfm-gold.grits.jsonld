    }
   }
  },
  {
   "@id": "q:smak-pca-assume",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "https://www.sams-xrays.com/pca-and-cluster-analysis",
    "sha256": "cdbcad825ce51c273216ac190f72b1c8226bbdd4d28a19ae9878352f64e76243",
    "media_type": "text/plain"
   },
   "target": {
    "hasSource": "https://www.sams-xrays.com/pca-and-cluster-analysis",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "The assumption here is that the areas that exhibit the greatest variation in signal are the areas that are chemically distinct."
    }
   }
  },
  {
   "@id": "q:smak-pca-noise",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "https://www.sams-xrays.com/pca-and-cluster-analysis",
    "sha256": "cdbcad825ce51c273216ac190f72b1c8226bbdd4d28a19ae9878352f64e76243",
    "media_type": "text/plain"
   },
   "target": {
    "hasSource": "https://www.sams-xrays.com/pca-and-cluster-analysis",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "pm with lower eigenvalues arise from noise."
    }
   }
  },
  {
   "@id": "q:pist-fit",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "XRF maps were fitted using PyMCA to ensure each element map has no overlapping fluorescence signal from elements of similar energies."
    }
   }
  },
  {
   "@id": "q:pist-blur",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "A filter was applied to all the elemental maps, which used a Gaussian distribution over an area of 5x5 pixels (with a standard deviation of 0.75)."
    }
   }
  },
  {
   "@id": "q:pist-scaling",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "the intensity scales of Ca and K were normalized to the same total counts which is 10x Cl, S and P. Similarly, Cl, S and P were scaled 10x Al and Mg."
    }
   }
  },
  {
   "@id": "q:pist-scaling-why",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "This allows for direct elemental comparisons between the samples, while still being able to observe differences in distribution in each element."
    }
   }
  },
  {
   "@id": "q:pist-stitch",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "The optical images from the beamline were stitched using a vision tool that uses feature detection and merging to create a composite image, rather than stitching based on coordinates."
    }
   }
  },
  {
   "@id": "q:pist-resize",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "The optical image was exported to the XRF file using a resize tool, which decreases the resolution of the optical image to that of the XRF, and uses coordinates in the file to align the images."
    }
   }
  },
  {
   "@id": "q:pist-resize-why",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "the loss of resolution of the optical image is acceptable, since the outline of the sample shape is the important marker for aligning XRF with FTIR images."
    }
   }
  },
  {
   "@id": "q:pist-ftir-atm",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "Spectra were corrected for atmospheric CO2 and water and denoised using a Savitzky-Golay filter (window size of 9 and polynomial order of 3), chosen to reduce high-frequency noise while preserving the shape and position of bands in the fingerprinting region."
    }
   }
  },
  {
   "@id": "q:pist-rubberband",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "A baseline rubberband method was applied, because the baseline across the acquired range is dominated by a smooth scattering offset well suited to a convex-hull correction, and was applied identically to every pixel and treatment so that any residual bias is systematic across the dataset."
    }
   }
  },
  {
   "@id": "q:pist-norm-1655",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "A mean normalization was applied at 1655 cm-1; while this can overlap with amide I, analyses were repeated with alternative normalization values (such as 2900 cm-1) which yielded the same results, confirming that observed spatial distributions are not an artefact of normalization."
    }
   }
  },
  {
   "@id": "q:pist-manual",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "Manual alignment was chosen over automatic registration tools due to slight rotation in the sample between data collection from each mode, as well as differences in the data detection (at BL14-3, the detector is at 45° to the sample, while at BL1.4.3 the detector is 90° to the sample) which can create image distortions."
    }
   }
  },
  {
   "@id": "q:pist-markers",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "up to 35 reference markers were placed on clear features of the optical image aligned with the XRF data, including the outline of each sample and internal features."
    }
   }
  },
  {
   "@id": "q:pist-repeat",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "The step was performed several times using different numbers of markers and marker positions to obtain the optimal alignment with the least amount of shear."
    }
   }
  },
  {
   "@id": "q:pist-rmse",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "The RMSE was calculated to validate registration accuracy; the average RMSE for both alignments was 11 pixels. If removing clearly misaligned markers (due to shear) the RMSE decreases to 8 pixels."
    }
   }
  },
  {
   "@id": "q:pist-bound",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "correlation of chemical imaging modalities on features smaller ~80 µm (8 pixel RMSE, each pixel ~10 µm), should be interpreted with caution"
    }
   }
  },
  {
   "@id": "q:pist-fa-weight",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "The data channels from individual modalities were grouped together and auto-balanced by weighting the data channels by the overall sum of factor magnitudes within each data group."
    }
   }
  },
  {
   "@id": "q:pist-fa-why",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "This process ensures that the inherently different intensity magnitudes of XRF versus FTIR data contribute comparably to the shared FA space."
    }
   }
  },
  {
   "@id": "q:pist-fa-shared",
   "@type": "prov:Entity",
   "plan": "plan:xfm-gold-0.1.0",
   "how": "quote",
   "agent": "claude-fable-5-1 + P.H. Zwart (hand-built gold graph)",
   "source": {
    "uri": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "sha256": "c3d3b771da5fab58f6a49173d479ff120ee100f8adea3b2b98b9dadab1a6fbaf",
    "media_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
   },
   "target": {
    "hasSource": "file://Mutlimodal_pistachio_manuscript_V5.docx",
    "selector": {
     "@type": "oa:TextQuoteSelector",
     "exact": "the FA model was fit such that the two samples share a common loading (component) matrix while each sample has its own matrix score per loading."
    }
